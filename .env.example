# Customer authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional until the business account is ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pre-launch email verification/recovery provider
RESEND_API_KEY=
AUTH_EMAIL_FROM=Deaf Shark Coffee <orders@example.com>

# Staff access (comma-separated business-controlled addresses)
STAFF_EMAILS=

# Public form abuse protection. Required before production launch.
TURNSTILE_SECRET_KEY=
