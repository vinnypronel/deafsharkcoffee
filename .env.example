# Customer authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Canonical public origin used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment identity and non-secret resource bindings. Set these explicitly in
# ignored .env.staging/.env.production files or the release environment.
# Runtime secrets below must be stored with Cloudflare/Sites, never committed.
DEPLOY_TARGET=
CF_WORKER_NAME=
CF_D1_DATABASE_ID=
CF_R2_BUCKET_NAME=

# Google OAuth (optional until the business account is ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional account email. Cloudflare Email Service is preferred through
# the EMAIL binding. Resend remains an optional fallback for local or staged use.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Deaf Shark Coffee <account@deafsharkcoffee.com>
CLOUDFLARE_EMAIL_ENABLED=false

# Staff access and notification routing (comma-separated addresses)
STAFF_EMAILS=admin@deafsharkcoffee.com
CONTACT_EMAILS=contact@deafsharkcoffee.com
EMPLOYMENT_EMAILS=employment@deafsharkcoffee.com
ADMIN_EMAILS=admin@deafsharkcoffee.com
SUPPORT_EMAIL=help@deafsharkcoffee.com

# Public form abuse protection. Required before production launch.
# Public widget key (safe to expose through /api/turnstile-config).
TURNSTILE_SITE_KEY=
# Secret key: store as a Worker secret in production, never in source control.
TURNSTILE_SECRET_KEY=

# Master switch for the website's own ordering. Must be exactly "true" to open the
# cart, the checkout, and POST /api/orders. Anything else, including unset, keeps
# ordering closed: the menu and prices stay visible and every order control shows
# the coming-soon notice. Closed is the default on purpose.
NEXT_PUBLIC_ORDERING_ENABLED=false
# Legacy hosted-ordering URL. Unused while the site takes its own orders.
NEXT_PUBLIC_ORDERING_URL=
# Comma-separated frontend hostnames returned by Siteverify. Production must not
# include localhost or 127.0.0.1. Example: deafsharkcoffee.com,www.deafsharkcoffee.com
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional order-ready text messages (not active until Twilio/A2P setup is complete)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
