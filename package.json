{
  "name": "deaf-shark-coffee-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .codex-temp --ignore-pattern .wrangler --ignore-pattern worker-configuration.d.ts --ignore-pattern env.d.ts",
    "launch:check": "node --env-file-if-exists=.env.local scripts/check-launch-config.mjs",
    "launch:check:production": "node --env-file-if-exists=.env.production scripts/check-launch-config.mjs",
    "build:production": "node --env-file-if-exists=.env.production node_modules/vinext/dist/cli.js build",
    "assets:audit": "node scripts/audit-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "npm run build && wrangler d1 migrations apply DB --local -c dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "npm run build:production && npm run worker:config:check && wrangler deploy -c dist/server/wrangler.json",
    "deploy:check:staging": "node scripts/deployment-preflight.mjs --target staging",
    "deploy:check:production": "node scripts/deployment-preflight.mjs --target production",
    "deploy:staging": "node scripts/deployment-preflight.mjs --target staging --apply",
    "deploy:production": "node scripts/deployment-preflight.mjs --target production --apply",
    "worker:config:check": "node scripts/check-generated-worker-config.mjs",
    "db:backup:remote": "node scripts/backup-d1.mjs",
    "db:audit:schema": "node scripts/audit-d1-schema.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "rollback:prepare": "node scripts/prepare-worker-rollback.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "0.45.2",
    "lenis": "^1.3.26",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
